<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NativeAOT / trimming safe: enables the trim, AOT and single-file analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>Devolutions.Psign.Core</AssemblyName>
    <RootNamespace>Devolutions.Psign.Core</RootNamespace>
    <PackageId>Devolutions.Psign.Core</PackageId>
    <Description>Pure C# psign core: Authenticode digest recomputation and portable signature verification (PE, CAB, MSI, MSIX/APPX, catalogs, scripts, ZIP, NuGet, VSIX, ClickOnce, App Installer, ESD, RDP), explicit trust anchors, AuthRoot, RFC 3161 and revocation validation, OPC primitives, and PKCS#7 / CMS parsing. Contains no signing code or private-key handling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devolutions.Psign.Signing" />
    <InternalsVisibleTo Include="psign-tool" />
    <InternalsVisibleTo Include="Devolutions.Psign.Tests" />
  </ItemGroup>

</Project>
