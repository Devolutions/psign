<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>Devolutions.Psign.Verification</AssemblyName>
    <RootNamespace>Devolutions.Psign.Verification</RootNamespace>
    <PackageId>Devolutions.Psign.Verification</PackageId>
    <Description>Pure C# portable Authenticode signature validation (PE, CAB, MSI, MSIX, catalogs, scripts, ZIP, NuGet, VSIX, ClickOnce, App Installer) with explicit trust anchors or the Microsoft AuthRoot CTL, RFC 3161 timestamps, and Azure Artifact Signing identity checks. Contains no signing code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devolutions.Psign.Signing" />
    <InternalsVisibleTo Include="Devolutions.Psign.Cli" />
    <InternalsVisibleTo Include="Devolutions.Psign.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devolutions.Psign.Core\Devolutions.Psign.Core.csproj" />
  </ItemGroup>

</Project>
