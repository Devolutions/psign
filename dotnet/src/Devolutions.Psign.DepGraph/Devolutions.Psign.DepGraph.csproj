<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>psign-depgraph</AssemblyName>
    <RootNamespace>Devolutions.Psign.DepGraph</RootNamespace>
    <AssemblyTitle>psign binary manifest / dependency graph generator (managed)</AssemblyTitle>
    <Description>Pure C# port of the Rust psign-depgraph tool: walks PE imports from signtool.exe and writes parity-output/binary-manifest.json and parity-output/dependency-graph.json.</Description>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devolutions.Psign.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devolutions.Psign.Core\Devolutions.Psign.Core.csproj" />
  </ItemGroup>

</Project>
