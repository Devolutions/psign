<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NativeAOT / trimming safe: enables the trim, AOT and single-file analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>psign-server</AssemblyName>
    <RootNamespace>Devolutions.Psign.Server</RootNamespace>
    <AssemblyTitle>psign local test services (managed)</AssemblyTitle>
    <Description>Pure C# psign-server: local RFC 3161 timestamp authority, code-signing PKI (AIA / CRL / OCSP), Azure Key Vault-compatible signing endpoint, and Azure Artifact Signing / Trusted Signing data-plane endpoint for deterministic loopback tests.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>psign-server</ToolCommandName>
    <PackageId>Devolutions.Psign.Server</PackageId>
    <PackageTags>psign;authenticode;timestamp;rfc3161;ocsp;crl;azure-key-vault;trusted-signing;test-server;dotnet-tool</PackageTags>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devolutions.Psign.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devolutions.Psign.Core\Devolutions.Psign.Core.csproj" />
  </ItemGroup>

</Project>
