<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- NativeAOT / trimming safe: enables the trim, AOT and single-file analyzers. -->
    <IsAotCompatible>true</IsAotCompatible>
    <AssemblyName>psign-tool</AssemblyName>
    <RootNamespace>Devolutions.Psign.Cli</RootNamespace>
    <AssemblyTitle>psign CLI (managed)</AssemblyTitle>
    <Description>Pure C# psign-tool CLI: portable Authenticode sign, verify, timestamp, inspect, and package helpers that run on Windows, Linux, and macOS without native code.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>psign-tool</ToolCommandName>
    <PackageId>Devolutions.Psign.Cli</PackageId>
    <PackageTags>psign;authenticode;signtool;code-signing;cli;dotnet-tool</PackageTags>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devolutions.Psign.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devolutions.Psign.Core\Devolutions.Psign.Core.csproj" />
    <ProjectReference Include="..\Devolutions.Psign.Verification\Devolutions.Psign.Verification.csproj" />
    <ProjectReference Include="..\Devolutions.Psign.Signing\Devolutions.Psign.Signing.csproj" />
  </ItemGroup>

</Project>
